{
  "title": "MPIC Overview",
  "uid": "mpic-overview",
  "schemaVersion": 39,
  "version": 7,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "tags": ["mpic"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total MPIC Requests",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } },
      "targets": [{ "expr": "round(sum(increase(mpic_http_server_duration_milliseconds_count{exported_job=\"mpic-coordinator\",http_target=\"/mpic\"}[$__range]))) or vector(0)", "legendFormat": "Requests" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "HTTP 200 Responses",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } } },
      "targets": [{ "expr": "round(sum(increase(mpic_http_server_duration_milliseconds_count{exported_job=\"mpic-coordinator\",http_target=\"/mpic\",http_status_code=\"200\"}[$__range]))) or vector(0)", "legendFormat": "200 OK" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "MPIC Decision: Invalid",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }] } } },
      "targets": [{ "expr": "round(sum(increase(mpic_mpic_requests_total{exported_job=\"mpic-coordinator\",mpic_is_valid=~\"(?i)false\"}[$__range]))) or vector(0)", "legendFormat": "is_valid=false" }]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "MPIC Decision: Valid",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } } },
      "targets": [{ "expr": "round(sum(increase(mpic_mpic_requests_total{exported_job=\"mpic-coordinator\",mpic_is_valid=~\"(?i)true\"}[$__range]))) or vector(0)", "legendFormat": "is_valid=true" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Operational Errors",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 10 }] } } },
      "targets": [{ "expr": "round(sum(increase(mpic_http_server_duration_milliseconds_count{exported_job=\"mpic-coordinator\",http_target=\"/mpic\",http_status_code=~\"4..|5..\"}[$__range]))) or vector(0)", "legendFormat": "4xx/5xx" }]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Avg Coordinator Duration (ms)",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 500 }, { "color": "red", "value": 2000 }] } } },
      "targets": [{ "expr": "sum(increase(mpic_http_server_duration_milliseconds_sum{exported_job=\"mpic-coordinator\",http_target=\"/mpic\",http_status_code=\"200\"}[$__range])) / clamp_min(sum(increase(mpic_http_server_duration_milliseconds_count{exported_job=\"mpic-coordinator\",http_target=\"/mpic\",http_status_code=\"200\"}[$__range])), 1)", "legendFormat": "avg ms" }]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Remote Check Errors",
      "gridPos": { "x": 0, "y": 4, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }] } } },
      "targets": [{ "expr": "round(sum(increase(mpic_mpic_remote_check_errors_total{exported_job=\"mpic-coordinator\"}[$__range]))) or vector(0)", "legendFormat": "remote errors" }]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "CAA Decision Rate: Valid vs Invalid",
      "gridPos": { "x": 4, "y": 4, "w": 10, "h": 4 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "valid" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "invalid" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "targets": [
        { "expr": "sum(increase(mpic_mpic_requests_total{exported_job=\"mpic-coordinator\",check_type=\"caa\",mpic_is_valid=~\"(?i)true\"}[5m])) / 300", "legendFormat": "valid" },
        { "expr": "sum(increase(mpic_mpic_requests_total{exported_job=\"mpic-coordinator\",check_type=\"caa\",mpic_is_valid=~\"(?i)false\"}[5m])) / 300", "legendFormat": "invalid" }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "DCV Decision Rate: Valid vs Invalid",
      "gridPos": { "x": 14, "y": 4, "w": 10, "h": 4 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "valid" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "invalid" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          }
        ]
      },
      "targets": [
        { "expr": "sum(increase(mpic_mpic_requests_total{exported_job=\"mpic-coordinator\",check_type=\"dcv\",mpic_is_valid=~\"(?i)true\"}[5m])) / 300", "legendFormat": "valid" },
        { "expr": "sum(increase(mpic_mpic_requests_total{exported_job=\"mpic-coordinator\",check_type=\"dcv\",mpic_is_valid=~\"(?i)false\"}[5m])) / 300", "legendFormat": "invalid" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Request Rate by Status",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "sum by (http_status_code) (increase(mpic_http_server_duration_milliseconds_count{exported_job=\"mpic-coordinator\",http_target=\"/mpic\"}[5m])) / 300", "legendFormat": "status={{http_status_code}}" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Coordinator P50 / P95 / P99 Latency (ms)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (increase(mpic_http_server_duration_milliseconds_bucket{exported_job=\"mpic-coordinator\",http_target=\"/mpic\",http_status_code=\"200\"}[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (increase(mpic_http_server_duration_milliseconds_bucket{exported_job=\"mpic-coordinator\",http_target=\"/mpic\",http_status_code=\"200\"}[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (increase(mpic_http_server_duration_milliseconds_bucket{exported_job=\"mpic-coordinator\",http_target=\"/mpic\",http_status_code=\"200\"}[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Checker Request Rate",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "sum by (exported_job,http_target,http_status_code) (increase(mpic_http_server_duration_milliseconds_count{exported_job=~\"mpic-(caa|dcv)-checker\"}[5m])) / 300", "legendFormat": "{{exported_job}} {{http_target}} {{http_status_code}}" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "CAA/DCV Duration (ms)",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (increase(mpic_http_server_duration_milliseconds_bucket{exported_job=\"mpic-caa-checker\",http_target=\"/caa\"}[5m])))", "legendFormat": "caa p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (increase(mpic_http_server_duration_milliseconds_bucket{exported_job=\"mpic-caa-checker\",http_target=\"/caa\"}[5m])))", "legendFormat": "caa p95" },
        { "expr": "histogram_quantile(0.50, sum by (le) (increase(mpic_http_server_duration_milliseconds_bucket{exported_job=\"mpic-dcv-checker\",http_target=\"/dcv\"}[5m])))", "legendFormat": "dcv p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (increase(mpic_http_server_duration_milliseconds_bucket{exported_job=\"mpic-dcv-checker\",http_target=\"/dcv\"}[5m])))", "legendFormat": "dcv p95" }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Decision Rate by Check Type and Outcome",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 8 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "sum by (check_type, mpic_is_valid) (increase(mpic_mpic_requests_total{exported_job=\"mpic-coordinator\"}[5m])) / 300", "legendFormat": "{{check_type}} is_valid={{mpic_is_valid}}" }
      ]
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Service Logs",
      "gridPos": { "x": 0, "y": 32, "w": 24, "h": 8 },
      "datasource": { "uid": "loki", "type": "loki" },
      "options": { "dedupStrategy": "none", "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "expr": "{service_name=~\"mpic-(coordinator|caa-checker|dcv-checker)\"}", "legendFormat": "" }]
    }
  ]
}
